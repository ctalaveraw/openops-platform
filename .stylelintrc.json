{
  "extends": [
    "stylelint-config-recommended"
  ],
  "rules": {
    "declaration-property-value-no-unknown": true
  },
  "overrides": [
    {
      "files": [
        "**/*.html",
        "**/*.htm"
      ],
      "customSyntax": "postcss-html",
      "rules": {
        "no-empty-source": null
      }
    }
  ]
}
